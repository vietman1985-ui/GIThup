#!/usr/bin/env python3
"""Launcher for the brain CLI that works without installation.

Hooks and .mcp.json call this file via ${CLAUDE_PLUGIN_ROOT}/bin/brain so the
plugin needs nothing but a Python 3 interpreter on PATH.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from brain.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
